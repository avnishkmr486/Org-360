# Copy to .env.local for local development, and add the same variables in
# Netlify → Site configuration → Environment variables for the deployed app.
# (Not used until the Supabase phase — the demo runs on mock data without them.)

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit this value.
SUPABASE_SERVICE_ROLE_KEY=
